# ==============================================================================
# QueueFlow Email Microservice Environment Variables
# ==============================================================================
# Set these in your Vercel Project Dashboard (Settings -> Environment Variables)
# or in a local .env file when testing with "vercel dev".
# ==============================================================================

# 1. Resend API Key (Get free key from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# 2. Firebase Service Account JSON (Get from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key)
# Paste the entire content of the downloaded .json file here as a single string.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}

# 3. Sender Identity (Optional, defaults to QueueFlow <onboarding@resend.dev>)
# In development (free tier), Resend's default sender onboarding@resend.dev only delivers
# to the email address registered with your Resend account.
# In production, verify your custom domain at https://resend.com/domains and set:
EMAIL_FROM=QueueFlow <notifications@yourdomain.com>
